# Sahayta — environment template.
# Copy to .env and fill in. NEVER commit a filled .env or any real keys.
# The app must boot and demo cleanly with ONLY the defaults below (no LLM key,
# no weather key): every AI call has a rule-based fallback and weather falls
# back to a clearly-labeled simulated feed.

# ---------------------------------------------------------------- database
# Dev/demo default (SQLite). Prod: postgresql+asyncpg://user:pass@host:5432/sahayta
SAHAYTA_DATABASE_URL=sqlite+aiosqlite:///./sahayta.db

# ------------------------------------------------------------------ server
SAHAYTA_HOST=127.0.0.1
SAHAYTA_PORT=8000
# Comma-separated origins allowed to call the API (frontend dev server, prod domain)
SAHAYTA_CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------- LLM
# Provider-agnostic, OpenAI-compatible. Defaults target GLM (Zhipu).
# Leave blank to run fully on the deterministic rule-based fallback.
SAHAYTA_LLM_BASE_URL=
SAHAYTA_LLM_MODEL=
SAHAYTA_LLM_API_KEY=
# Soft cap per request; pipeline aborts to fallback past this (prevents runaway cost)
SAHAYTA_LLM_MAX_TOKENS=1200
SAHAYTA_LLM_TIMEOUT_S=25
# Opt-in vision: "1" attaches photo bytes to severity calls (off by default)
SAHAYTA_LLM_VISION=

# ------------------------------------------------------------------ auth
# Admin (district official) key. Demo value; CHANGE in any real deployment.
SAHAYTA_ADMIN_KEY=demo-admin-key
# Optional service key for higher rate limits (trusted integrations only)
SAHAYTA_API_KEY=
# Set true to banner every page as DEMO MODE (default true until Wave 5 decides)
SAHAYTA_DEMO_MODE=true

# ----------------------------------------------------------------- media
# Local dir for uploaded SOS photos (git-ignored). Prod may set S3 vars instead.
SAHAYTA_MEDIA_DIR=./backend/media
SAHAYTA_MAX_UPLOAD_MB=8
# S3-compatible object storage (optional, prod). Leave blank for local disk.
SAHAYTA_S3_BUCKET=
SAHAYTA_S3_REGION=
SAHAYTA_S3_ACCESS_KEY=
SAHAYTA_S3_SECRET_KEY=
SAHAYTA_S3_ENDPOINT_URL=

# ----------------------------------------------------------------- weather
# live = poll the URL below; simulated = deterministic synthetic feed (labeled in UI)
SAHAYTA_WEATHER_MODE=simulated
# Keyless default (Open-Meteo). Failures auto-fall back to simulated + labeled.
SAHAYTA_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
SAHAYTA_WEATHER_INGEST_MINUTES=15

# ------------------------------------------------------------------- app
SAHAYTA_DEFAULT_LANG=hi
# District slugs tracked by the early-warning worker: "all" (default) = every
# district in the DB, or a comma-separated list, e.g. patna,vaishali,gaya
SAHAYTA_DISTRICTS=all
# Public URL of the frontend (used in alert links); dev default
SAHAYTA_PUBLIC_URL=http://localhost:3000
# Helpline number interpolated into alert templates ({helpline})
SAHAYTA_DEMO_HELPLINE=1077

# ------------------------------------------------- matching (Wave 2, Agent 5)
# Defaults for POST /api/tasks/match when the client omits them
SAHAYTA_MATCH_DEFAULT_MAX_RESULTS=5
SAHAYTA_MATCH_DEFAULT_MAX_DISTANCE_KM=25

# ---------------------------------------------- rate limits (Wave 2, Agent 5)
# Requests per rolling hour. POST /api/sos has its own tighter guest quota.
SAHAYTA_RL_GUEST_SOS_PER_HOUR=20
SAHAYTA_RL_GUEST_OTHER_PER_HOUR=200
SAHAYTA_RL_PRIVILEGED_PER_HOUR=1000

# Safety guardrails (Wave 4, Agent 10) — see docs/safety.md
SAHAYTA_SAFETY_SPAM_WINDOW_MINUTES=10
SAHAYTA_SAFETY_SPAM_THRESHOLD=5
SAHAYTA_SAFETY_CONFLICT_RADIUS_KM=2.0
SAHAYTA_SAFETY_CONFLICT_HOURS=6.0
SAHAYTA_SAFETY_CONFLICT_MIN_CLUSTER=3
SAHAYTA_SAFETY_DUP_WINDOW_HOURS=24.0
SAHAYTA_SAFETY_DUP_RADIUS_KM=5.0
